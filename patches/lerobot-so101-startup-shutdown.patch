+from dataclasses import dataclass, field
+from unittest.mock import Mock
+
+import pytest
+
+from lerobot.motors import Motor, MotorNormMode
+from tests.mocks.mock_motors_bus import MockMotorsBus
+
+
+@dataclass
+class ShutdownState:
+    enabled_ids: set[int] = field(default_factory=lambda: set(range(1, 7)))
+    attempted_ids: list[int] = field(default_factory=list)
+    errors: dict[int, Exception] = field(default_factory=dict)
+
+
+@pytest.fixture
+def shutdown_bus(monkeypatch) -> tuple[MockMotorsBus, ShutdownState]:
+    """Model enabled joints without opening any serial device."""
+    bus = MockMotorsBus(
+        "/dev/mock-shutdown",
+        {f"joint_{i}": Motor(i, "model_2", MotorNormMode.DEGREES) for i in range(1, 7)},
+    )
+    bus.port_handler.is_open = True
+    bus.port_handler.is_using = True
+    state = ShutdownState()
+
+    def disable_torque(motors: str | list[str] | None = None, num_retry: int = 0) -> None:
+        assert num_retry == 5
+        for name in bus._get_motors_list(motors):
+            motor_id = bus.motors[name].id
+            state.attempted_ids.append(motor_id)
+            if motor_id in state.errors:
+                raise state.errors[motor_id]
+            state.enabled_ids.remove(motor_id)
+
+    monkeypatch.setattr(bus, "disable_torque", Mock(side_effect=disable_torque))
+    monkeypatch.setattr(bus.port_handler, "clearPort", Mock())
+    monkeypatch.setattr(bus.port_handler, "closePort", Mock(wraps=bus.port_handler.closePort))
+    return bus, state
+
+
+def test_disconnect_attempts_every_joint_and_closes_after_elbow_overload(shutdown_bus):
+    bus, state = shutdown_bus
+    overload = RuntimeError("ID 3: Overload error!")
+    state.errors[3] = overload
+
+    with pytest.raises(RuntimeError, match="ID 3: Overload error!") as caught:
+        bus.disconnect()
+
+    assert caught.value is overload
+    assert state.attempted_ids == [1, 2, 3, 4, 5, 6]
+    assert state.enabled_ids == {3}
+    assert not bus.is_connected
+    bus.port_handler.closePort.assert_called_once_with()
+
+
+def test_disconnect_disables_all_joints_and_closes(shutdown_bus):
+    bus, state = shutdown_bus
+
+    bus.disconnect()
+
+    assert state.attempted_ids == [1, 2, 3, 4, 5, 6]
+    assert not state.enabled_ids
+    assert not bus.is_connected
+    assert not bus.port_handler.is_using
+    bus.port_handler.clearPort.assert_called_once_with()
+    bus.port_handler.closePort.assert_called_once_with()
+
+
+def test_disconnect_without_torque_writes_only_closes(shutdown_bus):
+    bus, state = shutdown_bus
+
+    bus.disconnect(disable_torque=False)
+
+    assert state.enabled_ids == set(range(1, 7))
+    assert not state.attempted_ids
+    assert not bus.is_connected
+    bus.disable_torque.assert_not_called()
+    bus.port_handler.clearPort.assert_not_called()
+    bus.port_handler.closePort.assert_called_once_with()
+
+
+def test_disconnect_reports_all_motor_faults_after_closing(shutdown_bus):
+    bus, state = shutdown_bus
+    state.errors = {3: RuntimeError("ID 3 overload"), 5: ConnectionError("ID 5 timeout")}
+
+    with pytest.raises(ExceptionGroup) as caught:
+        bus.disconnect()
+
+    assert caught.value.exceptions == tuple(state.errors.values())
+    assert state.attempted_ids == [1, 2, 3, 4, 5, 6]
+    assert state.enabled_ids == {3, 5}
+    assert not bus.is_connected
+
+
+def test_disconnect_still_disables_and_closes_if_clearing_port_fails(shutdown_bus):
+    bus, state = shutdown_bus
+    clear_error = OSError("Cannot clear serial input")
+    bus.port_handler.clearPort.side_effect = clear_error
+
+    with pytest.raises(OSError, match="Cannot clear serial input") as caught:
+        bus.disconnect()
+
+    assert caught.value is clear_error
+    assert not state.enabled_ids
+    assert not bus.is_connected
+    assert not bus.port_handler.is_using
+
+
+def test_disconnect_preserves_motor_fault_if_port_close_also_fails(shutdown_bus):
+    bus, state = shutdown_bus
+    overload = RuntimeError("ID 3 overload")
+    close_error = OSError("Cannot close serial port")
+    state.errors[3] = overload
+    bus.port_handler.closePort.side_effect = close_error
+
+    with pytest.raises(ExceptionGroup) as caught:
+        bus.disconnect()
+
+    assert caught.value.exceptions == (overload, close_error)
+    assert state.attempted_ids == [1, 2, 3, 4, 5, 6]
+    assert state.enabled_ids == {3}
+    bus.port_handler.closePort.assert_called_once_with()

+from collections.abc import Iterator
+from contextlib import contextmanager
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+
+from lerobot.robots.so_follower import SO101Follower, SO101FollowerConfig
+
+MOTOR_NAMES = (
+    "shoulder_pan",
+    "shoulder_lift",
+    "elbow_flex",
+    "wrist_flex",
+    "wrist_roll",
+    "gripper",
+)
+
+
+class StartupBus:
+    """Track the goals active at torque enable without opening a serial port."""
+
+    def __init__(self, fault: str | None = None) -> None:
+        self.motors = dict.fromkeys(MOTOR_NAMES)
+        self.present = {name: 1800 + index * 100 for index, name in enumerate(MOTOR_NAMES)}
+        self.goals = dict.fromkeys(MOTOR_NAMES, 0)
+        self.torque_enabled = False
+        self.enable_snapshots: list[dict[str, int]] = []
+        self.fault = fault
+
+    def disable_torque(self, *args: Any, **kwargs: Any) -> None:
+        self.torque_enabled = False
+
+    def enable_torque(self, *args: Any, **kwargs: Any) -> None:
+        self.enable_snapshots.append(self.goals.copy())
+        self.torque_enabled = True
+
+    @contextmanager
+    def torque_disabled(self, *args: Any, **kwargs: Any) -> Iterator[None]:
+        # Match the real bus: this context enables torque even when the body fails.
+        self.disable_torque()
+        try:
+            yield
+        finally:
+            self.enable_torque()
+
+    def configure_motors(self) -> None:
+        assert not self.torque_enabled
+        if self.fault == "configure":
+            raise RuntimeError("injected configure fault")
+
+    def sync_read(self, field: str, *, normalize: bool = True, **kwargs: Any) -> dict[str, float]:
+        assert not self.torque_enabled
+        assert field == "Present_Position"
+        if self.fault == "read":
+            raise RuntimeError("injected read fault")
+        return {name: value / 100 if normalize else value for name, value in self.present.items()}
+
+    def read(self, field: str, motor: str, *, normalize: bool = True, **kwargs: Any) -> float:
+        assert not self.torque_enabled
+        if self.fault == "read":
+            raise RuntimeError("injected read fault")
+        if field == "Present_Position":
+            return self.present[motor] / 100 if normalize else self.present[motor]
+        if field == "Goal_Position":
+            return self.goals[motor] / 100 if normalize else self.goals[motor]
+        raise AssertionError(field)
+
+    def write(self, field: str, motor: str, value: float, *, normalize: bool = True, **kwargs: Any) -> None:
+        assert not self.torque_enabled
+        if self.fault == "configure_write" and field == "P_Coefficient" and motor == "elbow_flex":
+            raise RuntimeError("injected configure_write fault")
+        if field != "Goal_Position":
+            return
+        if self.fault == "seed" and motor == "elbow_flex":
+            raise RuntimeError("injected seed fault")
+        self.goals[motor] = int(value * 100 if normalize else value)
+
+    def sync_write(
+        self, field: str, values: dict[str, float], *, normalize: bool = True, **kwargs: Any
+    ) -> None:
+        for motor, value in values.items():
+            self.write(field, motor, value, normalize=normalize)
+
+
+def make_follower(bus: StartupBus) -> SimpleNamespace:
+    # Call only configure(), without constructing a robot or any hardware bus.
+    return SimpleNamespace(bus=bus, config=SO101FollowerConfig(port="/dev/null"))
+
+
+def test_configure_seeds_raw_current_positions_before_enabling_torque() -> None:
+    bus = StartupBus()
+
+    SO101Follower.configure(make_follower(bus))
+
+    assert bus.torque_enabled
+    assert bus.enable_snapshots, "successful startup must enable torque"
+    assert all(snapshot == bus.present for snapshot in bus.enable_snapshots)
+    assert bus.goals == bus.present
+
+
+@pytest.mark.parametrize("fault", ["configure", "configure_write", "read", "seed"])
+def test_configure_failure_leaves_torque_disabled(fault: str) -> None:
+    bus = StartupBus(fault=fault)
+
+    with pytest.raises(RuntimeError, match=f"injected {fault} fault"):
+        SO101Follower.configure(make_follower(bus))
+
+    assert not bus.torque_enabled
+    assert not bus.enable_snapshots, "startup failures must never enable torque"

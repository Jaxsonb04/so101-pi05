# Copy to so101.env and fill in the first five values. so101.env stays out of git.
export HF_USER=your-hf-username
export LEADER_PORT=/dev/cu.usbmodemLEADER      # from lerobot-find-port
export FOLLOWER_PORT=/dev/cu.usbmodemFOLLOWER  # from lerobot-find-port
export WRIST_CAM=0                             # from lerobot-find-cameras opencv
export TOP_CAM=1                               # from lerobot-find-cameras opencv

export TASK="Pick up the cube and place it in the bin"
export DATASET=$HF_USER/so101_cube_bin
export POLICY=$HF_USER/pi05_so101_cube_bin
export CAMERAS="{ wrist: {type: opencv, index_or_path: $WRIST_CAM, width: 640, height: 480, fps: 30}, top: {type: opencv, index_or_path: $TOP_CAM, width: 640, height: 480, fps: 30}}"
